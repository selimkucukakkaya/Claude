# Microsoft Graph (Azure AD app registration)
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USER_ID=me
MS_REDIRECT_URI=http://localhost:8000/auth/callback

# Public HTTPS URL of this service (for Graph webhook). Use ngrok/Cloudflare tunnel in dev.
PUBLIC_BASE_URL=https://your-public-host.example.com
GRAPH_WEBHOOK_CLIENT_STATE=change-me-to-a-random-string

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local storage
DB_PATH=./data/state.db

# Target folder name for "move to folder" action (Outlook display name)
ARCHIVE_FOLDER_NAME=Arsiv
